              bundleIdentifier="com.alistairrutherford.tonnetzml"
              pluginFormats="buildVST3,buildStandalone" pluginCharacteristicsValue="pluginIsSynth,pluginWantsMidiIn,pluginProducesMidiOut"
              pluginName="TonnetzML" pluginDesc="New chords from played ones, by moving them on the Tonnetz chord lattice"
              pluginManufacturer="Alistair Rutherford" pluginManufacturerCode="ARut"
              pluginCode="Tnzl" pluginVST3Category="Instrument,Tools"
              cppLanguageStandard="17">
  <MAINGROUP id="tzMain" name="TonnetzML">
    <GROUP id="tzSrc0" name="Source">
      <GROUP id="tzGrp1" name="core/engine">
